{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haptilog-web-preview",
  "compatibility_date": "2026-10-16",
  "previews": {},
  "build": {
    "command": "npm run prepare:deploy"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "env": {
    "production": {
      "name": "haptilog-web",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "haptilog.keepory.app",
          "custom_domain": true
        }
      ]
    }
  }
}
